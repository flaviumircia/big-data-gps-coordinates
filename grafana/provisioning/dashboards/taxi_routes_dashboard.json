          "rawQuery": true,
          "rawSql": "SELECT\r\n    route_id,\r\n    (point ->> 'lat')::double precision AS latitude,\r\n    (point ->> 'lon')::double precision AS longitude,\r\n    start_lat,\r\n    start_lon,\r\n    end_lat,\r\n    end_lon,\r\n    idx AS point_order\r\nFROM taxi_routes,\r\njsonb_array_elements(path) WITH ORDINALITY AS t(point, idx)\r\nWHERE route_id = (\r\n    SELECT route_id \r\n    FROM taxi_routes \r\n    ORDER BY route_id DESC\r\n    LIMIT 1\r\n)\r\nORDER BY route_id, idx;\r\n",
